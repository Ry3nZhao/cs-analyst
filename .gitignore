# database files
*.db
*.db-wal
*.db-shm

# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# 本机样例配置（样例目录、主玩家 steamid），不进仓库
src/tauri/src-tauri/.cargo/config.toml

