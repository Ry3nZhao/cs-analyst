{
  "name": "@cs-analyst/sidecar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "cs-analyst-sidecar": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p protocol && tsc",
    "dev": "tsc -p protocol && tsc --watch",
    "start": "node dist/index.js",
    "test": "pnpm run build && node --test dist/**/*.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cs-analyst/downloader-protocol": "workspace:*",
    "axios": "^1.9.0",
    "csgo-sharecode": "^3.0.0",
    "globaloffensive": "^3.2.0",
    "p-queue": "^8.1.0",
    "p-timeout": "^6.1.4",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.2.0",
    "unbzip2-stream": "^1.4.3",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/globaloffensive": "^2.3.4",
    "@types/node": "^24.0.0",
    "@types/steam-totp": "^2.1.2",
    "@types/unzipper": "^0.10.11",
    "typescript": "^5.8.3"
  },
  "description": "CS Analyst 下载模块（JSON-RPC over stdio）。协议见 docs/downloader-protocol.md"
}
